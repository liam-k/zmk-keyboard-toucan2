#include "keymap_german.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define ADJ  3
#define SYS  4
#define PREC 5
#define SCRL 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&sk {
    release-after-ms = <500>;
    quick-release;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp ESC>;
            require-prior-idle-ms = <180>;
        };

        combo_up {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp UP>;
            require-prior-idle-ms = <180>;
        };

        page_up {
            timeout-ms = <50>;
            key-positions = <7 8 9>;
            bindings = <&kp PAGE_UP>;
            require-prior-idle-ms = <180>;
        };

        combo_down {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&kp DOWN>;
            require-prior-idle-ms = <180>;
        };

        page_down {
            timeout-ms = <75>;
            key-positions = <31 32 33>;
            bindings = <&kp PAGE_DOWN>;
            require-prior-idle-ms = <180>;
        };

        combo_left {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp LEFT>;
            require-prior-idle-ms = <180>;
        };

        combo_right {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp RIGHT>;
            require-prior-idle-ms = <180>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp RET>;
            require-prior-idle-ms = <180>;
        };

        combo_system {
            timeout-ms = <50>;
            key-positions = <36 41>;
            bindings = <&mo SYS>;
            require-prior-idle-ms = <180>;
        };


        combo_backspace {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp BSPC>;
            require-prior-idle-ms = <180>;
        };

        combo_backspace_hr {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp BSPC>;
            require-prior-idle-ms = <180>;
        };

        combo_backspace_left {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp BSPC>;
            require-prior-idle-ms = <180>;
        };

        combo_tab {
            timeout-ms = <40>;
            key-positions = <14 15>;
            bindings = <&kp TAB>;
            require-prior-idle-ms = <200>;
        };

        combo_shift_tab {
            timeout-ms = <40>;
            key-positions = <13 14>;
            bindings = <&kp LS(TAB)>;
            require-prior-idle-ms = <200>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <14 3>;
            bindings = <&kp LG(C)>;
            require-prior-idle-ms = <200>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <13 3>;
            bindings = <&kp LG(X)>;
            require-prior-idle-ms = <200>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <16 3>;
            bindings = <&kp LG(V)>;
            require-prior-idle-ms = <200>;
        };

        combo_undo {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp LG(DE_Z)>;
            require-prior-idle-ms = <200>;
        };

        combo_redo {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp LG(LS(DE_Z))>;
            require-prior-idle-ms = <200>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <33 34>;
            bindings = <&kp DEL>;
            require-prior-idle-ms = <180>;
        };
    };

    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 18 19 20 21 22 30 31 32 33 34 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        symbol_hold: symbol_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <180>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hs: homerow_shifts {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hthl: homerow_tap_hold_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&to>, <&to>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            require-prior-idle-ms = <160>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        blt: layertap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&to>, <&kp>;
        };

        mlt: mom_layertap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        mo_to: behavior_mo_to {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&sl>;
        };

        mt_caps_word_sticky_shift: mt_caps_word_sticky_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&caps_word>, <&sk>;
        };

        smart_shift: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none      &td LS(K) K          &td DE_AT DE_DOT        &td LS(O) O         &td LA(DE_MINS) DE_COMM  &td LS(DE_UDIA) DE_UDIA    &td LS(V) V       &td LS(G) G       &td LS(C) C       &td LS(L) L       &td LS(DE_Z) DE_Z  &none
                &none      &hml LSHFT H         &hml LCTRL A            &hml LALT E         &hml LGUI I             &td LS(DE_Y) DE_Y           &td LS(B) B       &hmr RGUI T       &hmr RALT R       &hmr RCTRL N      &hmr RSHFT F        &none
                &none      &td LS(X) X          &td LS(Q) Q             &td LS(DE_ADIA) DE_ADIA  &td LS(DE_U) DE_U  &td LS(DE_ODIA) DE_ODIA    &td LS(P) P       &td LS(D) D       &td LS(W) W       &td LS(M) M       &td LS(J) J         &none
                                      &mo NAV              &mlt SYM SPACE        &smart_shift               &mo_to SYM SYM       &td LS(S) S       &mo ADJ
            >;
        };

        symbol_layer {
            display-name = "SYM";
            bindings = <
                &none      &td ESC DE_BSLH      &kp DE_UNDS            &kp DE_LBKT         &kp DE_RBKT          &kp DE_CARET             &kp DE_EXCL      &kp MAC_LABK      &kp MAC_RABK     &kp DE_EQL             &kp DE_AMPS      &none
                &none      &kp DE_BSLH          &hml LCTRL DE_FSLH      &hml LALT DE_LBRC   &hml LGUI DE_RBRC   &kp DE_STAR              &kp DE_QUES      &hmr RGUI DE_LPAR &hmr RALT DE_RPAR &hmr RCTRL DE_MINS    &kp DE_COLN       &none
                &none      &kp DE_HASH          &kp MAC_PIPE            &symbol_hold DE_EURO DE_DLR   &kp DE_TILD          &kp DE_GRV               &kp DE_PLUS      &kp DE_PERC       &kp DE_DQT       &kp DE_SQT             &kp DE_SEMI      &none
                                      &kp DE_BSLH          &kp DE_DLR             &kp DE_COLN                 &kp DE_COMM          &kp DE_SS         &kp DE_DOT
            >;
        };

        num_nav_layer {
            display-name = "NUM NAV";
            bindings = <
                &none      &kp N1               &kp N2                  &kp N3              &kp N4               &kp N5                  &kp N6          &kp N7            &kp N8           &kp N9                 &kp N0           &none
                &none      &tog SCRL            &none                   &kp UP              &none                &mo PREC                &td DE_FSLH DE_STAR  &hmr RGUI N4   &hmr RALT N5     &hmr RCTRL N6          &kp DE_PLUS      &none
                &none      &none                &kp LEFT                &kp DOWN            &kp RIGHT            &none                   &kp DE_MINS      &kp N1            &kp N2           &kp N3                 &kp DE_DOT       &none
                                      &mkp MCLK            &mkp LCLK              &mkp RCLK                   &mkp LCLK            &mkp RCLK         &mkp MCLK
            >;
        };

        adjust_layer {
            display-name = "ADJ";
            bindings = <
                &none      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp F7       &kp F8       &kp F9       &none           &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp BSPC  &none
                &none      &kp C_VOL_DN          &kp C_VOL_UP          &kp F4       &kp F5       &kp F6       &kp ESC         &kp LEFT    &kp DOWN          &kp UP      &kp RIGHT &none
                &none      &kp C_MUTE            &none                 &kp F1       &kp F2       &kp F3       &kp LS(TAB)     &kp TAB     &kp SPACE         &kp RET     &kp BSPC  &none
                                                   &kp F10                 &kp F11             &kp F12                 &none        &none      &none
            >;
        };

        system_layer {
            display-name = "SYS";
            bindings = <
                &none      &bt BT_CLR_ALL  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4    &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &bootloader  &none
                &none      &bt BT_CLR      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &studio_unlock  &bt BT_DISC 4  &sys_reset    &none         &none        &none
                &none      &none           &none          &none          &none          &none           &none           &none          &none          &none         &none        &none
                                               &none          &none          &none                  &none      &none      &none
            >;
        };

        precision_mode {
            display-name = "PREC";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        scroll_mode {
            display-name = "SCROLL";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
